# ──────────────────────────────────────────────────
# Coaching × Milestone — Environment Variables
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in your Monday.com API token.
#
# Get your token from: Monday.com → avatar (bottom left) → Administration
# → Connections → API, or from your personal profile → Developers → My
# Access Tokens. Keep this token private — anyone with it can read/write
# your whole Monday account, and this app sends it from the browser, so
# only use this app with people you trust (see README.md "Security note").
VITE_MONDAY_API_TOKEN=your-monday-api-token-here

# Board ID — the single consolidated "Coaching x Milestone" board in the
# Monday workspace of the same name. Everything (officers, tasks, daily
# tasks, resources, messages, daily activity log) lives on this one board,
# split into groups. You only need to change this if you rebuild the board.
VITE_MONDAY_BOARD=18422565403
